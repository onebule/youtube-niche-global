NEXT_PUBLIC_YOUTUBE_SIGNALS_URL=https://your-api-domain.example/api/youtube-signals
NEXT_PUBLIC_VIDEO_GATEWAY_URL=https://your-api-domain.example/api/video
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Optional server-only full-video analysis adapter. If empty, the built-in
# backend provider performs thumbnail + public-metadata analysis with low confidence.
VIRAL_CASE_ANALYSIS_URL=
VIRAL_CASE_ANALYSIS_TOKEN=

# Phase 1 AI Video Compute Broker. Keep disabled until routing is validated.
VIDEO_COMPUTE_BROKER_ENABLED=false
VIDEO_COMPUTE_BROKER_DRY_RUN=true
API_COST_GUARD_RATIO=
VIDEO_COMPUTE_MAX_FALLBACKS=2
VIDEO_COMPUTE_CIRCUIT_FAILURE_THRESHOLD=3
VIDEO_COMPUTE_CIRCUIT_COOLDOWN_MS=60000

# Server-only provider configuration. Never expose these values to the browser.
MODAL_H3_ENDPOINT=
MODAL_H3_TOKEN=
MODAL_H3_MODEL=MiniMax-H3
MODAL_H3_COST_PER_SECOND_USD=
MODAL_H3_HARDWARE=H3_ECO
RUNPOD_H3_ENDPOINT=
RUNPOD_API_KEY=
RUNPOD_H3_MODEL=MiniMax-H3
RUNPOD_H3_COST_PER_SECOND_USD=
RUNPOD_H3_HARDWARE=H3_ECO
VIDEO_GATEWAY_BASE_URL=https://youtube-niche-global-api.vercel.app/api/video
VIDEO_GATEWAY_AUTH_TOKEN=
H3_API_MODEL=minimax-h3
H3_API_COST_PER_SECOND_USD=
# Model cache is an explicit deployment boundary. Keep false until weights,
# volume persistence, and a real inference smoke test are verified.
H3_MODEL_CACHE_DIR=
H3_MODEL_VERSION=
H3_MODEL_CACHE_READY=false
H3_MODEL_CACHE_LOADING=false

# Phase 1.5 isolated MiniMax H3 Modal deployment gates. Keep all false/empty
# until the read-only check, model preparation, and one manual smoke test are
# completed with auditable evidence. These values are server/deployment-only.
MODAL_VOLUME_NAME=minimax-h3-model-cache
MODAL_APP_NAME=signalcraft-h3-t2va
MODAL_H3_PROFILE=H3_MODAL_RELIABLE
H3_MODEL_REPOSITORY=MiniMaxAI/MiniMax-H3
HF_SECRET_NAME=huggingface-secret
H3_HF_LICENSE_ACCEPTED=false
H3_CUDA_READY=false
H3_RUNTIME_READY=false
H3_SERIALIZATION_READY=false
H3_OUTPUT_VALIDATION_READY=false
H3_SMOKE_RESOLUTION=768x1344
H3_SMOKE_DURATION_SECONDS=5
ALLOW_REAL_GPU_INFERENCE=false
ALLOW_PAID_GPU_INFERENCE=false
H3_FREE_CREDIT_CONFIRMED=false
H3_ESTIMATED_SMOKE_COST_USD=
MAX_REAL_SMOKE_TEST_COST_USD=0
H3_PREPARE_ALLOW_REMOTE=false
H3_SMOKE_EXECUTE=false

# Hugging Face ZeroGPU MiniMax H3 adapter. Keep real generation disabled until
# a read-only discovery check and one manually authorized T2V smoke are complete.
# HF_TOKEN is server-only and must never be exposed to browser code or logs.
HF_ZEROGPU_H3_ENABLED=false
HF_ZEROGPU_H3_SMOKE_ONLY=true
ALLOW_HF_ZEROGPU_REAL_GENERATION=false
HF_ZEROGPU_H3_SPACE=MiniMaxAI/MiniMax-H3-Turbo-Lora
HF_ZEROGPU_MAX_WAIT_SECONDS=
# External HF policy signal only; do not interpret this as an unlimited quota.
HF_ZEROGPU_EXPECTED_DAILY_QUOTA_MINUTES=5
HF_H3_OUTPUT_DIR=tmp/generated/hf-h3
HF_ZEROGPU_BRIDGE_PATH=services/hf-zerogpu/gradio_bridge.py
HF_TOKEN=
